{
  "name": "dzr-cron",
  "version": "3.0.2",
  "description": "Deezer Cron Scripts",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "cron:once": "tsx ./run-once.ts",
    "cron:mask": "tsx ./utils/mask-tokens.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "lint": "prettier . --check && oxlint && dev-config sync --check",
    "lint:fix": "prettier . --write && oxlint --fix",
    "prepare": "dev-config hooks"
  },
  "author": "smndhm",
  "license": "ISC",
  "prettier": "@dume/dev-config/lint/prettier",
  "devDependencies": {
    "@dume/dev-config": "1.4.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "nock": "15.0.5",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
